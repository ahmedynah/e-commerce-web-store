@startuml
title E-Commerce Entity-Relationship Diagram

hide methods
hide stereotypes
skinparam linetype ortho
skinparam roundcorner 0
skinparam shadowing false

entity "Product" as Product {
  * product_id : BIGINT <<PK>>
  --
  product_name : VARCHAR(255)
  product_short_description : VARCHAR(255)
  product_long_description : TEXT
  product_size : VARCHAR(50)
  product_color : VARCHAR(50)
  product_image_url : VARCHAR(255)
  product_weight : DECIMAL(10,2)
  product_quantity_on_hand : INT
  product_shipping_cost : DECIMAL(10,2)
  product_price : DECIMAL(10,2)
  product_status : ENUM(active, deleted)
}

entity "Comment" as Comment {
  * comment_id : BIGINT <<PK>>
  --
  * comment_product_id : BIGINT <<FK>>
  * comment_customer_id : BIGINT <<FK>>
  comment_text : TEXT
  comment_date : TIMESTAMP
}

entity "Order" as Order {
  * order_id : BIGINT <<PK>>
  --
  * order_customer_id : BIGINT <<FK>>
  order_total_shipping_cost : DECIMAL(10,2)
  order_taxes : DECIMAL(10,2)
  order_total_cost : DECIMAL(10,2)
  order_date : TIMESTAMP
}

entity "Order Item" as OrderItem {
  * order_item_id : BIGINT <<PK>>
  --
  * order_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  product_quantity : INT
}

entity "Discount" as Discount {
  * discount_id : BIGINT <<PK>>
  --
  discount_code : VARCHAR(50)
  discount_description : TEXT
  discount_amount : DECIMAL(10,2)
  discount_percentage : DECIMAL(5,2)
  discount_start_date : DATE
  discount_end_date : DATE
}

entity "Category" as Category {
  * category_id : BIGINT <<PK>>
  --
  category_name : VARCHAR(255)
  category_description : TEXT
}

entity "Product Category" as ProductCategory {
  * product_category_id : BIGINT <<PK>>
  --
  * product_id : BIGINT <<FK>>
  * category_id : BIGINT <<FK>>
}

entity "Customer" as Customer {
  * customer_id : BIGINT <<PK>>
  --
  customer_name : VARCHAR(255)
  customer_email : VARCHAR(255)
  customer_password : VARCHAR(255)
  customer_address : TEXT
  customer_phone : VARCHAR(50)
}

entity "Customer Discount" as CustomerDiscount {
  * customer_id : BIGINT <<PK, FK>>
  * discount_id : BIGINT <<PK, FK>>
}

entity "Order Discount" as OrderDiscount {
  * order_discount_id : BIGINT <<PK>>
  --
  * order_id : BIGINT <<FK>>
  * discount_id : BIGINT <<FK>>
}

Product ||--o{ Comment : receives
Customer ||--o{ Comment : writes

Customer ||--o{ Order : places
Order ||--|{ OrderItem : contains
Product ||--o{ OrderItem : ordered

Product ||--|{ ProductCategory : classified
Category ||--o{ ProductCategory : includes

Customer ||--o{ CustomerDiscount : receives
Discount ||--o{ CustomerDiscount : assigned

Order ||--o{ OrderDiscount : uses
Discount ||--o{ OrderDiscount : applied

@enduml
